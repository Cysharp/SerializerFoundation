<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Since net10.0 is defined as the minimum version where `allows ref struct` can be used, it must not be removed in the future. -->
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- interface members carry the docs; implementing members are intentionally undocumented -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>

    <!-- Strong naming: friend assemblies (tests) sign with the same key -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\..\opensource.snk</AssemblyOriginatorKeyFile>
    <SerializerFoundationPublicKey></SerializerFoundationPublicKey>

    <!-- NuGet -->
    <IsPackable>true</IsPackable>
    <PackageId>SerializerFoundation</PackageId>
    <Description>High performance serialization infrastructure for C#.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Analyzer: runs on this project (keeps the NonCopyable protection on the buffer structs themselves)
       and ships inside this package under analyzers/dotnet/cs so consumers get SF001-SF003 automatically.
       ReferenceOutputAssembly=false keeps it out of the package dependencies; it is not a separate NuGet package. -->
  <ItemGroup>
    <ProjectReference Include="..\SerializerFoundation.Analyzers\SerializerFoundation.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <None Include="..\SerializerFoundation.Analyzers\bin\$(Configuration)\netstandard2.0\SerializerFoundation.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- Global Usings -->
  <ItemGroup>
    <Using Include="System.Buffers" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
  </ItemGroup>

  <!-- Internals Visible To -->
  <ItemGroup>
    <InternalsVisibleTo Include="SerializerFoundation.Tests" Key="$(SerializerFoundationPublicKey)" />
  </ItemGroup>

</Project>
